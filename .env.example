# naad-web configuration. Copy to .env for local builds, or set these as build-time environment
# variables in your host (e.g. Vercel Project Settings → Environment Variables).
#
# Both are optional. Unset, the app falls back to same-origin (works if naad-web and naad share an
# origin/reverse proxy) and no Authorization header — matching a naad engine run with
# ALLOW_UNAUTHENTICATED=true. A per-browser override entered on the Settings page always wins over
# these, so this build can still be pointed at a different engine without a rebuild.
#
# Baking these in makes the engine URL and API key visible to anyone who inspects this build's JS —
# that's the tradeoff for "works with no setup." Only do this for a single-engine deployment you're
# fine with being effectively public (the engine's own rate limiting is still the real defense against
# abuse, not this key).

VITE_NAAD_ENGINE_URL=https://your-engine.example
VITE_NAAD_API_KEY=
